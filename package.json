{
	"name": "@dulysse1/ts-helper",
	"version": "1.4.9",
	"description": "A personal TypeScript playground to explore the limits of the type system and keep growing my knowledge ✨",
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=24",
		"pnpm": ">=12"
	},
	"scripts": {
		"build": "tsup",
		"format": "prettier . --write",
		"lint": "npx eslint --fix .",
		"prepublishOnly": "pnpm build",
		"prepare": "husky",
		"check-exports": "attw --pack . --ignore-rules cjs-resolves-to-esm",
		"test:type": "npx tsc --project tsconfig.type-test.json --extendedDiagnostics",
		"test": "vitest"
	},
	"keywords": [
		"node",
		"typescript",
		"type",
		"types",
		"safe",
		"tools",
		"typesafe",
		"utility",
		"helpers",
		"ts-helper"
	],
	"author": {
		"name": "Ulysse Dupont",
		"url": "https://github.com/dulysse",
		"email": "ulyssedupont2707@gmail.com"
	},
	"repository": {
		"url": "https://github.com/Dulysse/ts-helper",
		"type": "public"
	},
	"bugs": {
		"url": "https://github.com/Dulysse/ts-helper/issues"
	},
	"type": "module",
	"homepage": "https://github.com/Dulysse/ts-helper/blob/master/README.md",
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./any": {
			"types": "./dist/any/index.d.ts",
			"import": "./dist/any/index.js",
			"default": "./dist/any/index.js"
		},
		"./array": {
			"types": "./dist/array/index.d.ts",
			"import": "./dist/array/index.js",
			"default": "./dist/array/index.js"
		},
		"./brand": {
			"types": "./dist/brand/index.d.ts",
			"import": "./dist/brand/index.js",
			"default": "./dist/brand/index.js"
		},
		"./class": {
			"types": "./dist/class/index.d.ts",
			"import": "./dist/class/index.js",
			"default": "./dist/class/index.js"
		},
		"./lab": {
			"types": "./dist/lab/index.d.ts",
			"import": "./dist/lab/index.js",
			"default": "./dist/lab/index.js"
		},
		"./numeric": {
			"types": "./dist/numeric/index.d.ts",
			"import": "./dist/numeric/index.js",
			"default": "./dist/numeric/index.js"
		},
		"./object": {
			"types": "./dist/object/index.d.ts",
			"import": "./dist/object/index.js",
			"default": "./dist/object/index.js"
		},
		"./operator": {
			"types": "./dist/operator/index.d.ts",
			"import": "./dist/operator/index.js",
			"default": "./dist/operator/index.js"
		},
		"./string": {
			"types": "./dist/string/index.d.ts",
			"import": "./dist/string/index.js",
			"default": "./dist/string/index.js"
		},
		"./test": {
			"types": "./dist/test/index.d.ts",
			"import": "./dist/test/index.js",
			"default": "./dist/test/index.js"
		},
		"./union": {
			"types": "./dist/union/index.d.ts",
			"import": "./dist/union/index.js",
			"default": "./dist/union/index.js"
		}
	},
	"types": "./dist/index.d.ts",
	"typesVersions": {
		"*": {
			"any": [
				"dist/any/index.d.ts"
			],
			"array": [
				"dist/array/index.d.ts"
			],
			"brand": [
				"dist/brand/index.d.ts"
			],
			"class": [
				"dist/class/index.d.ts"
			],
			"lab": [
				"dist/lab/index.d.ts"
			],
			"numeric": [
				"dist/numeric/index.d.ts"
			],
			"object": [
				"dist/object/index.d.ts"
			],
			"operator": [
				"dist/operator/index.d.ts"
			],
			"string": [
				"dist/string/index.d.ts"
			],
			"test": [
				"dist/test/index.d.ts"
			],
			"union": [
				"dist/union/index.d.ts"
			]
		}
	},
	"main": "./dist/index.js",
	"private": false,
	"license": "ISC",
	"devDependencies": {
		"@arethetypeswrong/cli": "0.18.5",
		"@eslint/js": "9.39.1",
		"@typescript-eslint/eslint-plugin": "^8.71.0",
		"@typescript-eslint/parser": "^8.71.0",
		"@vitest/coverage-v8": "^5.0.3",
		"eslint": "9.39.1",
		"eslint-plugin-prettier": "5.5.4",
		"globals": "16.5.0",
		"husky": "9.1.7",
		"prettier": "3.6.2",
		"tsup": "8.5.1",
		"typescript": "5.9.3",
		"typescript-eslint": "8.47.0",
		"vite-tsconfig-paths": "^6.1.1",
		"vitest": "^5.0.3"
	}
}
